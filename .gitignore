# Secrets: the real config NEVER enters the repo.
# It lives at /etc/cpap-monitor/config.toml (see docs/DEPLOY.md).
config.toml

# Site network values (contains the plug-network Wi-Fi passphrase).
# Only network/network.env.example (placeholders) is committed.
network/network.env
*.env

# Health data: CPAP logs and summaries are personal medical information.
*.log
logs/
nightly-summaries/

# Alarm audio (copyrighted tracks; copy onto the Pi out-of-band).
*.mp3

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/

# Runtime alarm: Jimmy Cliff + licensed Envato pulse, rebuilt by scripts/make-wakeup.sh
sounds/wakeup.wav
sounds/candidates/
