# cpap-monitor systemd unit.
#
# Install (or just run scripts/install.sh):
#   sudo cp systemd/cpap-monitor.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now cpap-monitor
#
# Deploy path is /home/cnewton/cpap-monitor (a git checkout of this repo);
# the real config lives at /etc/cpap-monitor/config.toml (0640,
# root:cnewton). ExecStartPre validates the config so a broken edit fails
# LOUDLY at start instead of producing a monitor that silently can't alarm.

[Unit]
Description=CPAP failure alarm (smart-plug wattage watchdog)
Documentation=file:///home/cnewton/cpap-monitor/README.md
# The plug network is LOCAL — the Pi hosts its own `cpap` Wi-Fi AP and the
# monitor talks to the plug over it. It needs NO internet/ethernet, so do NOT
# gate startup on network-online.target: that would delay (or, on some
# hardware, stall) boot while waiting for an uplink that may not exist (hotel /
# Iceland / no ethernet). Start once NetworkManager is up (it brings the AP);
# the runner's startup delay + SEARCHING/retry loop tolerates the AP settling.
After=NetworkManager.service sound.target

[Service]
Type=simple
User=cnewton
WorkingDirectory=/home/cnewton/cpap-monitor

# REQUIRED for the siren to actually make sound: sox `play` needs the user's
# audio session. Without this the alarm can fire but stay SILENT — the worst
# failure mode. Assumes the operator account is uid 1000 (the Pi default);
# change /run/user/1000 if the account's uid differs (`id -u <user>`).
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStartPre=/usr/bin/python3 -m cpapmon --config /etc/cpap-monitor/config.toml validate
ExecStart=/usr/bin/python3 -m cpapmon --config /etc/cpap-monitor/config.toml run

# This is a safety device: always come back.
Restart=always
RestartSec=5
# Never give up restarting, even during a crash loop.
StartLimitIntervalSec=0

# Make sure the siren always dies when the service stops/restarts — a looping
# sox `play` child can otherwise outlive a hard restart and keep blaring.
ExecStopPost=-/usr/bin/pkill -f "play .*"

# Journald captures stdout/stderr; view with:
#   journalctl -u cpap-monitor -f
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
