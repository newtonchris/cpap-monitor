# network.env.example — site values for the Pi-hosted plug Wi-Fi network.
#
# Copy to network/network.env, fill in the real values, and run
# `sudo network/setup-network.sh` (or `make network`).
#
# network/network.env is GITIGNORED. It contains the Wi-Fi passphrase and
# must NEVER be committed — this repo is public. Everything in THIS example
# file is a placeholder or a harmless site convention.

# --- Access point -------------------------------------------------------
# SSID of the plug network the Pi hosts on wlan0.
CPAP_AP_SSID="cpap"

# WPA2 passphrase, 8-63 characters. The plugs store this too, so changing
# it means re-provisioning every plug.
CPAP_AP_PSK="REPLACE_ME"

# Wireless interface that hosts the AP (the Pi's onboard radio).
CPAP_AP_IFACE="wlan0"

# 2.4 GHz channel (ESP8266 plugs are 2.4 GHz-only; band is fixed to bg).
CPAP_AP_CHANNEL="6"

# The Pi's address on the plug subnet, CIDR form. The Pi is also the DHCP
# server and NAT gateway for this subnet (NetworkManager "shared" mode).
CPAP_AP_ADDR="192.168.77.1/24"

# --- Static DHCP reservations (plug pinning) ----------------------------
# One entry per line: MAC=IP,hostname
# Pinning plug IPs by MAC is NOT optional polish: an unpinned plug that
# drifts to a new lease silently breaks the monitor's `host` config — IP
# drift is exactly how the predecessor alarm was dead for 78 days.
# Convention: .11 = Tasmota plug. One line per plug. The MAC below is an
# example; read yours off the plug label or the lease table
# (/var/lib/NetworkManager/dnsmasq-wlan0.leases).
CPAP_PLUG_RESERVATIONS="
40:4c:ca:f8:ca:ac=192.168.77.11,tasmota-cpap
"
